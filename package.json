{
  "name": "ai-chat-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c yellow,cyan \"npm:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "server": "tsx watch server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "axios": "^1.7.9",
    "dompurify": "^3.4.16",
    "element-plus": "^2.14.6",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@vercel/node": "^16.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
